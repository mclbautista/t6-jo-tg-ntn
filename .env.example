TELEGRAM_BOT_TOKEN=
# Notion internal integration token (Read content + Insert content).
NOTION_API_KEY=
# DeepSeek classify/extract (#20).
DEEPSEEK_API_KEY=
# Jev Deliverable matcher via OpenRouter's Decisions API (#26).
OPENROUTER_API_KEY=
