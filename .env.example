# Copy to .env and fill in real secrets. .env is git-ignored and never committed.
# Compose injects this file into the container (env_file: .env).

# From BotFather.
TELEGRAM_BOT_TOKEN=
# In `telegram_mode: gateway` (#95) the token is not needed here; this module secret
# (the gateway's WATCHDOG_SECRET, 32+ characters) takes its place:
# WATCHDOG_SECRET=
# Notion internal integration token (Read content + Insert content).
NOTION_API_KEY=
# DeepSeek classify/extract (#20).
DEEPSEEK_API_KEY=
# Jev Deliverable matcher via OpenRouter's Decisions API (#26).
OPENROUTER_API_KEY=
